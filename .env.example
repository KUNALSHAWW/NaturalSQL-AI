# Database (SQLite file, or a SQLAlchemy URL for MySQL/PostgreSQL; use a read-only account)
NATURALSQL_DB_URL=sqlite:///demo_retail.db

# Model provider: groq | openai | ollama
NATURALSQL_PROVIDER=groq
GROQ_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# NATURALSQL_MODEL=llama-3.3-70b-versatile
# For a local model: NATURALSQL_PROVIDER=ollama and NATURALSQL_MODEL=gemma4:e4b

# Generation
NATURALSQL_CANDIDATES=3
NATURALSQL_MAX_REPAIRS=2

# Safety policy
NATURALSQL_MAX_ROWS=1000
NATURALSQL_TIMEOUT_S=10
# Columns that can never be queried, and (optionally) the only tables that may be read
NATURALSQL_DENIED_COLUMNS=password_hash,ssn
# NATURALSQL_ALLOWED_TABLES=customers,orders,products

# REST API: when set, every request needs the header X-API-Key
# NATURALSQL_API_KEYS=change-me
